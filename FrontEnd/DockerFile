# frontend/Dockerfile

# --- ETAPA 1: Construcción (Node) ---
FROM node:22-alpine as build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
# Asumo que tu script de build es "npm run build"
RUN npm run build

# --- ETAPA 2: Servidor (Nginx) ---
FROM nginx:alpine
# Copiamos los archivos compilados al directorio de Nginx
# NOTA: Si usas Vite, la carpeta suele ser 'dist'. Si usas Create-React-App, es 'build'.
# Ajusta 'dist' o 'build' según tu proyecto.
COPY --from=build /app/dist /usr/share/nginx/html

# Copiamos configuración básica de Nginx (opcional, para SPA routing)
# COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]