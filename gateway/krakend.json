{
    "version": 3,
    "name": "Inspector AI Gateway",
    "port": 8080,
    "cache_ttl": "5s",
    "timeout": "5000ms",
    "extra_config": {
        "github_com/devopsfaith/krakend-gologging": {
            "level": "DEBUG",
            "prefix": "[KRAKEND]",
            "syslog": false,
            "stdout": true
        },
        "github_com/devopsfaith/krakend-cors": {
            "allow_origins": [
                "*"
            ],
            "allow_methods": [
                "GET",
                "POST",
                "PUT",
                "DELETE"
            ],
            "allow_headers": [
                "Authorization",
                "Content-Type"
            ]
        }
    },
    "endpoints": [
        {
            "endpoint": "/health",
            "method": "GET",
            "output_encoding": "json",
            "backend": [
                {
                    "url_pattern": "/api/v1/health",
                    "host": [
                        "http://open_balena_apis:5000"
                    ],
                    "disable_host_sanitize": false
                }
            ]
        },
        {
            "endpoint": "/v1/infodevices",
            "method": "GET",
            "output_encoding": "json",
            "backend": [
                {
                    "url_pattern": "/api/v1/infodevices",
                    "host": [
                        "http://open_balena_apis:5000"
                    ],
                    "is_collection": true,
                    "mapping": {
                        "collection": "devices"
                    }
                }
            ],
            "extra_config": {
                "auth/validator": {
                    "alg": "RS256",
                    "jwk_url": "http://keycloak:8080/realms/inspector_realm/protocol/openid-connect/certs",
                    "issuer": "http://localhost:8080/realms/inspector_realm",
                    "disable_jwk_security": true,
                    "roles_key": "roles",
                    "roles": [
                        "admin",
                        "ing_red",
                        "Inspector_admin",
                        "Inspector_lectura"
                    ],
                    "audience": [
                        "inspector_client"
                    ],
                    "operation_debug": true,
                    "error_headers": true,
                    "error_log_level": "DEBUG"
                }
            }
        }
    ]
}