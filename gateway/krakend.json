        {
            "endpoint": "/health",
            "method": "GET",
            "level": "DEBUG",
            "backend": [
                {
                    "url_pattern": "/api/v1/health",
                    "host": [
                        "http://open_balena_apis:5000"
                    ]
                }
            ]
        },
