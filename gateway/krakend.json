            "endpoint": "/v1/infodevices",
            "method": "GET",
            "level": "DEBUG",
            "backend": [
                {
                    "url_pattern": "/api/v1/infodevices",
                    "host": [
                        "http://open_balena_apis:5000"
                    ],
                    "is_collection": true,
                    "mapping": {
                        "collection": "devices"
                    }
                }
            ],
            "extra_config": {
                "auth/validator": {
                    "issuer": "http://localhost:8080/realms/inspector_realm",
                    "jwk_url": "http://keycloak:8080/realms/inspector_realm/protocol/openid-connect/certs",
                    "disable_jwk_security": true,
                    "alg": "RS256",
                    "roles_key": "roles",
                    "roles": [
                        "Inspector_viewer",
                        "Inspector_operator",
                        "Inspector_admin"
                    ],
                    "propagate_claims": [
                        [
                            "sub",
                            "X-User-Id"
                        ],
                        [
                            "roles",
                            "X-Role"
                        ]
                    ]
                }
            }
