{
    "version": 3,
    "name": "Inspector AI Gateway",
    "port": 8080,
    "cache_ttl": "60s",
    "timeout": "5000ms",
    "extra_config": {
        "github_com/devopsfaith/krakend-gologging": {
            "level": "DEBUG",
            "prefix": "[KRAKEND]",
            "syslog": false,
            "stdout": true
        },
        "github_com/devopsfaith/krakend-cors": {
            "allow_origins": [
                "*"
            ],
            "allow_methods": [
                "GET",
                "POST",
                "PUT",
                "DELETE"
            ],
            "allow_headers": [
                "Authorization",
                "Content-Type"
            ]
        }
    },
