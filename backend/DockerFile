# backend/Dockerfile
FROM python:3.11-slim

# Evita archivos .pyc y buffers
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Dependencias del sistema (gcc y libpq para compilar drivers de DB)
RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# 1. Copiamos requirements primero (Caché de Docker)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 2. Copiamos TODO el contenido de la carpeta backend (src, databases, main.py, .env)
COPY . .

# Comando de inicio
# Nota: Como main.py está en la raíz, se llama "main:app", no "src.main:app"
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "5000"]